# ── API ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── WalletConnect (get free key at cloud.walletconnect.com) ──────
NEXT_PUBLIC_WC_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# ── Stripe (live key for production) ─────────────────────────────
NEXT_PUBLIC_STRIPE_PK=pk_live_YOUR_STRIPE_LIVE_PUBLISHABLE_KEY

# ── Polygon PoS MAINNET (Chain ID: 137) ──────────────────────────
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYOUR_MAINNET_CONTRACT_ADDRESS

# ── Optional: Custom RPC (faster than public) ────────────────────
# NEXT_PUBLIC_POLYGON_RPC=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
