# ── Server ───────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://carbonx.app

# ── Database ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carbonx
DB_USER=carbonx_user
DB_PASSWORD=STRONG_PASSWORD_HERE

# ── Auth ─────────────────────────────────────────────────────────
JWT_SECRET=GENERATE_WITH: openssl rand -hex 32

# ── Payments ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET

# ── Polygon PoS MAINNET (Chain ID: 137) ──────────────────────────
# Free public RPC — no key needed:
POLYGON_RPC=https://polygon-rpc.com
# OR use Alchemy (recommended for production):
# POLYGON_RPC=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
# OR QuickNode:
# POLYGON_RPC=https://YOUR_ENDPOINT.quiknode.pro/YOUR_KEY

# Contract deployed on Polygon Mainnet
CONTRACT_ADDRESS=0xYOUR_MAINNET_CONTRACT_ADDRESS

# Relayer wallet (keep this secret — never commit to git)
RELAYER_PRIVATE_KEY=YOUR_PRIVATE_KEY_WITHOUT_0x_PREFIX

# ── Email ────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_specific_password
SMTP_FROM=CarbonX <noreply@carbonx.app>
ADMIN_EMAIL=admin@carbonx.app
