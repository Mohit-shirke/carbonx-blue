# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database (Docker PostgreSQL) ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carbonx_db
DB_USER=carbonx
DB_PASSWORD=password

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_USE_A_64_CHAR_RANDOM_SECRET_AT_MINIMUM_HERE_12345678
JWT_EXPIRES_IN=7d

# ─── Stripe (get from dashboard.stripe.com → TEST MODE) ──────────────────────
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# ─── Blockchain (Polygon Amoy) ────────────────────────────────────────────────
POLYGON_AMOY_RPC=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
RELAYER_PRIVATE_KEY=0xYOUR_METAMASK_TESTNET_PRIVATE_KEY

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# Option A — Gmail SMTP (enable "App Passwords" in Google Account settings)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD

# Option B — SendGrid (recommended for production)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.YOUR_SENDGRID_API_KEY

# Option C — Resend (easiest for India)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=re_YOUR_RESEND_API_KEY

SMTP_FROM=CarbonX Registry <noreply@carbonx.app>

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@carbonx.app
SEND_LOGIN_ALERTS=false

# ─── Frontend URL (for CORS + email links) ────────────────────────────────────
FRONTEND_URL=http://localhost:3000
